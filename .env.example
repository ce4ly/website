# Copiar a .env y rellenar. No commitear .env ni claves.

# --- Mailgun (formulario /contacto) ---
# https://documentation.mailgun.com/
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.ce4ly.cl

# US: https://api.mailgun.net
# EU: https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.eu.mailgun.net

# Remitente verificado en el dominio anterior (opcional; si falta se usa noreply@MAILGUN_DOMAIN)
MAILGUN_FROM=Radio Club Lircay <noreply@mg.ce4ly.cl>

# Destinatario (opcional; por defecto contacto@ce4ly.cl)
CONTACT_TO=contacto@ce4ly.cl

# --- Boletines RSS ---
# ID numérico del perfil SoundCloud. Si no está, /boletines.xml responde 503
# y la lista de episodios se omite. El perfil público es
# https://soundcloud.com/radio-club-lircay (ID 1676930966).
SOUNDCLOUD_USER_ID=1676930966

# Puerto del servidor de producción (npm start; opcional, por defecto 4173)
# PORT=4173

# En el servidor solo vive dist/. `npm run build` (y por tanto `npm run deploy`)
# escribe dist/api/mailgun.local.php y dist/api/boletines.local.php desde estas
# variables. No hace falta copiar nada a mano en el VPS.
